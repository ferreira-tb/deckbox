{
  "name": "deckbox",
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "cargo +nightly -Zscript scripts/build-app.rs",
    "clean": "cargo +nightly -Zscript scripts/clean.rs && cargo clean",
    "clippy": "cargo +nightly -Zscript scripts/run-clippy.rs",
    "dev": "cargo tauri dev",
    "format": "dprint fmt && cargo fmt --all",
    "lint": "eslint . --config eslint.config.ts",
    "preview": "cargo +nightly -Zscript scripts/build-app.rs --preview",
    "type-check": "pnpm run -r --bail type-check",
    "udeps": "cargo +nightly udeps"
  },
  "dependencies": {
    "@lucide/vue": "=1.17.0",
    "@tauri-apps/api": "=2.11.0",
    "@tauri-apps/plugin-dialog": "=2.7.1",
    "@tauri-apps/plugin-fs": "=2.5.1",
    "@tauri-apps/plugin-opener": "=2.5.4",
    "@tauri-apps/plugin-os": "=2.3.2",
    "@tauri-apps/plugin-process": "=2.3.1",
    "@tauri-apps/plugin-updater": "=2.10.1",
    "@tauri-store/pinia": "=4.2.0",
    "@tb-dev/utils": "=7.3.22",
    "@tb-dev/vue": "=4.0.24",
    "@tb-dev/vue-components": "=7.1.23",
    "@tb-dev/vue-sonner": "=1.0.4",
    "@vueuse/core": "=14.3.0",
    "es-toolkit": "=1.47.0",
    "fuse.js": "=7.3.0",
    "pinia": "=3.0.4",
    "reka-ui": "=2.9.8",
    "tw-animate-css": "=1.4.0",
    "vue": "=3.5.35",
    "vue-router": "=5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "=4.3.0",
    "@tauri-apps/cli": "=2.11.2",
    "@tb-dev/eslint-config": "=10.0.11",
    "@types/node": "=25.9.1",
    "@vitejs/plugin-vue": "=6.0.7",
    "eslint": "=10.4.0",
    "tailwindcss": "=4.3.0",
    "tslib": "=2.8.1",
    "typescript": "=6.0.3",
    "vite": "=8.0.14",
    "vue-tsc": "=3.3.2"
  }
}
